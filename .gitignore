.env

# Local build output
/server

# macOS Finder droppings
.DS_Store

# Per-machine Claude Code settings.
.claude/settings.local.json

# Built by `task web:build` and embedded into the binary. The placeholder keeps
# //go:embed compiling on a fresh clone.
web/node_modules/
web/dist/*
!web/dist/.gitkeep

# Xcode and SwiftPM
xcuserdata/
*.xcuserstate
DerivedData/
.build/
*.xcresult

# --- Build output: never commit a binary. ---
# CI enforces this by file content (.github/workflows/no-binaries.yml); these
# entries keep the usual outputs from ever being staged.
bin/
tmp/
.build/
*.exe
*.test
*.o
*.a
*.so
*.dylib
/air
/golangci-lint
/main
/postitheka
/server
/sqlc
/tailwindcss
/templ
