.env

# Local build output
/server

# macOS Finder droppings
.DS_Store

# Per-machine Claude Code settings.
.claude/settings.local.json

# Built by `task web:build` and embedded into the binary. The placeholder keeps
# //go:embed compiling on a fresh clone.
web/node_modules/
web/dist/*
!web/dist/.gitkeep

# Xcode and SwiftPM
xcuserdata/
*.xcuserstate
DerivedData/
.build/
*.xcresult

# --- Build output: never commit a binary. ---
# CI enforces this by file content (.github/workflows/no-binaries.yml); these
# entries keep the usual outputs from ever being staged.
bin/
tmp/
.build/
*.exe
*.test
*.o
*.a
*.so
*.dylib
/air
/golangci-lint
/main
/postitheka
/server
/sqlc
/tailwindcss
/templ

# The 3D mascot (BRD-001): built by brand/tools/build_mascot3d.py from a source kit kept
# outside the repo. Rebuild it rather than commit it; a CDN hosts it for a beta deployment.
/out/
ios/Postitheka/Mascot3D/Mascot.usdz

# Python bytecode (brand/tools scripts)
__pycache__/
