GO_ENV=development
LISTEN_ADDR=:8095
# Where users reach the server; OAuth platforms redirect to
# $PUBLIC_URL/oauth/{platform}/callback. Defaults to http://localhost:8095 outside production.
PUBLIC_URL=

# Matches docker-compose.yml.
DATABASE_URL=postgres://postitheka:postitheka@localhost:5452/postitheka?sslmode=disable

# Applied on boot in development. Must be false in-cluster, where the schema
# is applied once by a PreSync hook running `server migrate`.
AUTO_MIGRATE=true

# Seals platform credentials at rest. Generate with `openssl rand -base64 32`.
# Changing it orphans every connected account.
TOKEN_ENCRYPTION_KEY=

# RustFS from docker-compose. In production: the R2 endpoint
# (<account>.r2.cloudflarestorage.com), S3_REGION=auto, S3_USE_SSL=true.
S3_ENDPOINT=localhost:9020
S3_REGION=auto
S3_BUCKET=postitheka-media
S3_ACCESS_KEY=postitheka
S3_SECRET_KEY=postitheka-dev
S3_USE_SSL=false

PUBLISH_WORKERS=4
LOG_LEVEL=info

# LinkedIn developer app: add "Share on LinkedIn" and "Sign In with LinkedIn using
# OpenID Connect", and list $PUBLIC_URL/oauth/linkedin/callback as a redirect URL.
# Leave both empty to not offer LinkedIn.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Threads app (Meta app with the "Access the Threads API" use case): the Threads
# app id and secret from App settings > Basic, with
# $PUBLIC_URL/oauth/threads/callback as a redirect callback URL. Until App Review
# only the app's Threads testers can connect. Leave both empty to not offer Threads.
THREADS_APP_ID=
THREADS_APP_SECRET=

# Product analytics (PostHog). Leave the key empty and nothing is captured and
# nothing is sent: the right setting for local development.
POSTHOG_API_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
