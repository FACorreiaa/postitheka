GO_ENV=development
LISTEN_ADDR=:8095
# Where users reach the server; OAuth platforms redirect to
# $PUBLIC_URL/oauth/{platform}/callback. Defaults to http://localhost:8095 outside production.
PUBLIC_URL=

# Matches docker-compose.yml.
DATABASE_URL=postgres://postitheka:postitheka@localhost:5452/postitheka?sslmode=disable

# Applied on boot in development. Must be false in-cluster, where the schema
# is applied once by a PreSync hook running `server migrate`.
AUTO_MIGRATE=true

# Seals platform credentials at rest. Generate with `openssl rand -base64 32`.
# Changing it orphans every connected account.
TOKEN_ENCRYPTION_KEY=

# RustFS from docker-compose. In production: the R2 endpoint
# (<account>.r2.cloudflarestorage.com), S3_REGION=auto, S3_USE_SSL=true.
S3_ENDPOINT=localhost:9020
S3_REGION=auto
S3_BUCKET=postitheka-media
S3_ACCESS_KEY=postitheka
S3_SECRET_KEY=postitheka-dev
S3_USE_SSL=false

PUBLISH_WORKERS=4
LOG_LEVEL=info
# text or json. Empty picks text in development and json in production.
LOG_FORMAT=
# How long in-flight requests and publish jobs get after SIGTERM. In-cluster,
# terminationGracePeriodSeconds must be longer than this.
SHUTDOWN_TIMEOUT=30s

# LinkedIn developer app: add "Share on LinkedIn" and "Sign In with LinkedIn using
# OpenID Connect", and list $PUBLIC_URL/oauth/linkedin/callback as a redirect URL.
# Leave both empty to not offer LinkedIn.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Threads app (Meta app with the "Access the Threads API" use case): the Threads
# app id and secret from App settings > Basic, with
# $PUBLIC_URL/oauth/threads/callback as a redirect callback URL. Until App Review
# only the app's Threads testers can connect. Leave both empty to not offer Threads.
THREADS_APP_ID=
THREADS_APP_SECRET=

# Instagram app (Meta app with the Instagram use case, "API setup with Instagram
# login"): the Instagram app id and secret shown there, not the Meta app's own.
# List $PUBLIC_URL/oauth/instagram/callback as an OAuth redirect URI. Only
# professional accounts (Business or Creator) can connect, and until App Review
# only accounts with a role on the app. Leave both empty to not offer Instagram.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# Facebook Pages (the same Meta app, with Facebook Login): here it is the Meta
# app's own id and secret, from App settings > Basic. List
# $PUBLIC_URL/oauth/facebook/callback under Facebook Login > Settings > Valid
# OAuth Redirect URIs. Until App Review only people with a role on the app can
# connect their Pages. Leave both empty to not offer Facebook.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# X (console.x.com): an app with OAuth 2.0 enabled as a "Web App, Automated App
# or Bot" (a confidential client), and $PUBLIC_URL/oauth/x/callback as a
# callback URL. X is pay-per-use: every post is billed to this app, so set a
# spending limit in the console first. Leave both empty to not offer X.
X_CLIENT_ID=
X_CLIENT_SECRET=

# TikTok (developers.tiktok.com): an app with Login Kit and the Content Posting
# API, the video.upload scope, and $PUBLIC_URL/oauth/tiktok/callback as a
# redirect URI (TikTok takes https only). Videos arrive in the account's TikTok
# inbox as drafts. Leave both empty to not offer TikTok.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Product analytics (PostHog). Leave the key empty and nothing is captured and
# nothing is sent: the right setting for local development.
POSTHOG_API_KEY=
POSTHOG_HOST=https://eu.i.posthog.com

# The 3D mascot on the sign-in page (BRD-001), a beta experiment. Leave empty in production:
# empty means the flat mascot. Locally, after building the model into out/mascot3d/, set it to
# /mascot3d/mascot.glb and use `task web:dev`, which serves that folder.
MASCOT_3D_MODEL_URL=

# Sign in with Apple (AUTH-001). Client ids, not secrets; both empty turns it off. The iOS
# app's bundle ids (comma separated) and the web's Services ID. No private key is needed.
APPLE_BUNDLE_IDS=com.fernandocorreia.postitheka
APPLE_WEB_CLIENT_ID=
# Sign in with Google (AUTH-002): the iOS OAuth client ids (comma separated) and the web one,
# from Google Cloud > APIs & Services > Credentials. Not secrets; no client secret is used.
# Both empty turns Google sign-in off.
GOOGLE_IOS_CLIENT_IDS=
GOOGLE_WEB_CLIENT_ID=
