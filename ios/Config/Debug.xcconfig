// The server a Debug build talks to. Not a secret: the app holds no
// credentials but the user's own token, kept in the Keychain. The simulator
// reaches the Mac's localhost; a device needs the Mac's .local name.
API_BASE_URL = http:/$()/localhost:8095

// Sign in with Apple (AUTH-001). Beta inherits it from Release.
CODE_SIGN_ENTITLEMENTS = Postitheka/Postitheka.entitlements
